---
import { BadgeCheck, Clock3, MapPin } from '@lucide/astro';
---

<section class="trust-strip">
  <div class="container trust-grid">
    <div class="trust-item"><span class="trust-icon"><MapPin size={19} /></span><span><b>Sunnyside based</b><small>Proudly serving Eastern Washington</small></span></div>
    <div class="trust-item"><span class="trust-icon"><BadgeCheck size={19} /></span><span><b>Licensed &amp; bonded</b><small>Trained professionals you can trust</small></span></div>
    <div class="trust-item"><span class="trust-icon"><Clock3 size={19} /></span><span><b>Here when you need us</b><small>Our management team is always available</small></span></div>
  </div>
</section>
