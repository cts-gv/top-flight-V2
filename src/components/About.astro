---
import { ArrowRight, Check } from '@lucide/astro';
import BrandLogo from './BrandLogo.astro';
import { siteConfig } from '../data/siteConfig';
---

<section id="about" class="section about-section">
  <div class="container about-grid">
    <div class="about-image-wrap">
      <img src={siteConfig.images.about} alt="Security team members standing together" width="1400" height="1000" loading="lazy" decoding="async" />
      <div class="image-stamp">
        <BrandLogo height={26} class="stamp-logo" />
        <span>Top Flight<br /><b>Security</b></span>
      </div>
    </div>
    <div class="about-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span> Who we are</div>
      <h2>Security that lets you <em>stay in the moment.</em></h2>
      <p>
        When you are hosting a celebration, running a business, or protecting your home, you should not have to carry
        every concern yourself. We bring a calm, capable presence so you can focus on what matters.
      </p>
      <p>
        Based in Sunnyside, Top Flight Security serves the Yakima Valley and surrounding communities with thoughtful
        planning, professional personnel, and real local commitment.
      </p>
      <div class="check-list">
        <span><Check size={15} /> People-first service</span>
        <span><Check size={15} /> Clear communication</span>
        <span><Check size={15} /> Responsive coverage</span>
      </div>
      <a class="text-link" href="#contact">Talk with our team <ArrowRight size={16} /></a>
    </div>
  </div>
</section>
