---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/siteConfig';

interface Props {
  /** Rendered height in CSS pixels */
  height: number;
  class?: string;
  variant?: 'light' | 'dark';
}

const { height, class: className, variant = 'light' } = Astro.props;
const src = variant === 'dark' ? siteConfig.images.logoDark : siteConfig.images.logo;
// logo artwork is 1200x627
const width = Math.round((height * 1200) / 627);
---

<Image
  src={src}
  alt=""
  width={width}
  height={height}
  densities={height > 100 ? [1, 2] : [1, 2, 3]}
  class={className}
  loading="eager"
  decoding="async"
/>
